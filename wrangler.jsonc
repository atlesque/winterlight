{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winterlight",
  "compatibility_date": "2026-10-09",
  // The static site, plus a small Worker for the runbook's shared ticks (/api/*).
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Runbook ticks and expense switches. Schema in migrations/.
  // /runbook and /api/runbook sit behind Cloudflare Access (Alex only).
  "d1_databases": [
    {
      "binding": "RUNBOOK_DB",
      "database_name": "winterlight",
      "database_id": "9c8fc928-9012-494b-84e7-8322db75069a",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "previews": {}
}
