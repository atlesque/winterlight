    "@fontsource-variable/fraunces": "^5.3.0",
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
